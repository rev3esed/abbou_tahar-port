---
import Layout from '../layouts/Layout.astro';
import activities from '../data/activities.json';
---

<Layout title="Scientific Activities" description="Research projects, PRFU teams, PAM manuscript platform, and editorial boards of Prof. Dr. Tahar Abbou.">
  <div class="page-header">
    <span class="page-tag">Research & Service</span>
    <h1 class="page-title">Scientific Activities & Leadership</h1>
    <p class="page-description">
      National research projects (PRFU / DGRSDT), manuscript cataloging initiatives, editorial responsibilities, and university scientific council appointments.
    </p>
  </div>

  <div class="activities-categories">
    {activities.map((cat) => (
      <section class="activity-section">
        <h2 class="cat-title">{cat.category}</h2>

        <div class="projects-grid">
          {cat.items.map((item) => (
            <article class="academic-card project-card">
              <span class="badge badge-gold">{item.role}</span>
              
              <h3 class="project-title">{item.title}</h3>
              
              {item.institution && (
                <p class="project-institution">🏛️ {item.institution}</p>
              )}
              
              {item.director && (
                <p class="project-director">👤 Supervised by: <strong>{item.director}</strong></p>
              )}
              
              {item.period && (
                <p class="project-period">📅 Period: {item.period}</p>
              )}

              {item.url && (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="project-link">
                  Official Portal ↗
                </a>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

<style>
  .activities-categories {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .cat-title {
    font-size: 1.75rem;
    color: var(--color-primary);
    margin-bottom: 1.25rem;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    border-top: 3px solid var(--color-primary);
    display: flex;
    flex-direction: column;
  }

  .project-title {
    font-size: 1.25rem;
    margin: 0.75rem 0 0.5rem;
    line-height: 1.35;
    color: var(--color-primary);
  }

  .project-institution {
    font-size: 0.9rem;
    font-weight: 600;
    color: #334155;
    margin-bottom: 0.25rem;
  }

  .project-director {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .project-period {
    font-size: 0.85rem;
    color: #64748b;
    margin-bottom: 1rem;
  }

  .project-link {
    margin-top: auto;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .project-link:hover {
    text-decoration: underline;
  }
</style>
