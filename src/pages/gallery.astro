---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const galleryEntries = await getCollection('gallery');
const gallery = galleryEntries.map(g => g.data);
---

<Layout title="Photo Gallery" description="Photographic documentation of international academic conferences, fieldwork, and symposiums of Prof. Dr. Tahar Abbou.">
  <div class="page-header">
    <span class="page-tag">Academic Archive</span>
    <h1 class="page-title">Photo Gallery</h1>
    <p class="page-description">
      Visual documentation of international conference presentations, university sessions, manuscript research fieldwork, and scholarly delegations. Click any photo to view full size.
    </p>
  </div>

  <div class="gallery-grid">
    {gallery.map((item, idx) => (
      <article class="academic-card gallery-item-card">
        <button
          type="button"
          class="gallery-image-frame"
          data-lightbox-index={idx}
          data-src={item.image}
          data-title={item.title}
          data-event={item.event}
          data-caption={item.caption}
          aria-label={`View full size photo: ${item.title}`}
        >
          <img src={item.image} alt={item.title} class="gallery-photo" loading="lazy" />
          <span class="zoom-pill" aria-hidden="true">🔍 View Full</span>
        </button>
        <div class="gallery-item-body">
          <h3 class="photo-card-title">{item.title}</h3>
          <p class="photo-card-event">{item.event}</p>
          <p class="photo-card-caption">{item.caption}</p>
        </div>
      </article>
    ))}
  </div>

  <!-- Lightbox Modal -->
  <div class="lightbox-overlay" id="galleryLightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <button type="button" class="lb-close" id="lbClose" aria-label="Close photo viewer">×</button>
    <button type="button" class="lb-nav lb-prev" id="lbPrev" aria-label="Previous photo">‹</button>
    <div class="lb-content">
      <img id="lbImage" src="" alt="" />
      <div class="lb-meta">
        <h3 id="lbTitle"></h3>
        <p class="lb-event" id="lbEvent"></p>
        <p class="lb-caption" id="lbCaption"></p>
      </div>
    </div>
    <button type="button" class="lb-nav lb-next" id="lbNext" aria-label="Next photo">›</button>
  </div>
</Layout>

<script is:inline>
  (function () {
    var triggers = Array.prototype.slice.call(document.querySelectorAll('[data-lightbox-index]'));
    var modal = document.getElementById('galleryLightbox');
    var imgEl = document.getElementById('lbImage');
    var titleEl = document.getElementById('lbTitle');
    var eventEl = document.getElementById('lbEvent');
    var captionEl = document.getElementById('lbCaption');
    var closeBtn = document.getElementById('lbClose');
    var prevBtn = document.getElementById('lbPrev');
    var nextBtn = document.getElementById('lbNext');
    if (!modal || !triggers.length) return;

    var currentIndex = 0;

    function showSlide(index) {
      currentIndex = (index + triggers.length) % triggers.length;
      var item = triggers[currentIndex];
      imgEl.src = item.getAttribute('data-src') || '';
      imgEl.alt = item.getAttribute('data-title') || '';
      titleEl.textContent = item.getAttribute('data-title') || '';
      eventEl.textContent = item.getAttribute('data-event') || '';
      captionEl.textContent = item.getAttribute('data-caption') || '';
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    triggers.forEach(function (btn, idx) {
      btn.addEventListener('click', function () {
        showSlide(idx);
      });
    });

    closeBtn.addEventListener('click', closeModal);
    prevBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      showSlide(currentIndex - 1);
    });
    nextBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      showSlide(currentIndex + 1);
    });

    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', function (e) {
      if (!modal.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowLeft') showSlide(currentIndex - 1);
      if (e.key === 'ArrowRight') showSlide(currentIndex + 1);
    });
  })();
</script>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  .gallery-item-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .gallery-image-frame {
    width: 100%;
    height: 260px;
    background: #0a192f;
    overflow: hidden;
    border: none;
    padding: 0;
    cursor: zoom-in;
    position: relative;
    display: block;
  }

  .gallery-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .gallery-item-card:hover .gallery-photo {
    transform: scale(1.04);
  }

  .zoom-pill {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background: rgba(10, 25, 47, 0.82);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .gallery-image-frame:hover .zoom-pill {
    opacity: 1;
  }

  .gallery-item-body {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .photo-card-title {
    font-size: 1.2rem;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .photo-card-event {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .photo-card-caption {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Lightbox */
  .lightbox-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(10, 25, 47, 0.94);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .lightbox-overlay.is-open {
    display: flex;
  }

  .lb-content {
    max-width: 960px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .lb-content img {
    max-width: 100%;
    max-height: 70vh;
    border-radius: 8px;
    object-fit: contain;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }

  .lb-meta {
    text-align: center;
    color: #f8fafc;
    max-width: 720px;
  }

  .lb-meta h3 {
    color: #ffffff;
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .lb-event {
    color: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  .lb-caption {
    color: #cbd5e1;
    font-size: 0.9rem;
  }

  .lb-close,
  .lb-nav {
    position: fixed;
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }

  .lb-close:hover,
  .lb-nav:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .lb-close {
    top: 1.25rem;
    right: 1.25rem;
    width: 44px;
    height: 44px;
    font-size: 1.75rem;
    line-height: 1;
  }

  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
    font-size: 1.8rem;
  }

  .lb-prev { left: 1.25rem; }
  .lb-next { right: 1.25rem; }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .lb-nav {
      width: 38px;
      height: 38px;
      font-size: 1.4rem;
    }

    .lb-prev { left: 0.5rem; }
    .lb-next { right: 0.5rem; }
  }
</style>
