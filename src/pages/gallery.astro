---
import Layout from '../layouts/Layout.astro';
import gallery from '../data/gallery.json';
---

<Layout title="Photo Gallery" description="Photographic documentation of international academic conferences, fieldwork, and symposiums of Prof. Dr. Tahar Abbou.">
  <div class="page-header">
    <span class="page-tag">Academic Archive</span>
    <h1 class="page-title">Photo Gallery</h1>
    <p class="page-description">
      Visual documentation of international conference presentations, university sessions, manuscript research fieldwork, and scholarly delegations.
    </p>
  </div>

  <div class="gallery-grid">
    {gallery.map((item) => (
      <div class="academic-card gallery-item-card">
        <div class="gallery-image-frame">
          <img src={item.image} alt={item.title} class="gallery-photo" loading="lazy" />
        </div>
        <div class="gallery-item-body">
          <h3 class="photo-card-title">{item.title}</h3>
          <p class="photo-card-event">{item.event}</p>
          <p class="photo-card-caption">{item.caption}</p>
        </div>
      </div>
    ))}
  </div>
</Layout>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  .gallery-item-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .gallery-image-frame {
    width: 100%;
    height: 260px;
    background: #0a192f;
    overflow: hidden;
  }

  .gallery-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .gallery-item-card:hover .gallery-photo {
    transform: scale(1.04);
  }

  .gallery-item-body {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .photo-card-title {
    font-size: 1.2rem;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .photo-card-event {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .photo-card-caption {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>
