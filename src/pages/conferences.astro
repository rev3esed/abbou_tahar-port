---
import Layout from '../layouts/Layout.astro';
import conferences from '../data/conferences.json';
---

<Layout title="Conferences & Symposiums" description="National and international conference papers presented by Prof. Dr. Tahar Abbou worldwide.">
  <div class="page-header">
    <span class="page-tag">Academic Presentations</span>
    <h1 class="page-title">Conferences & Symposiums</h1>
    <p class="page-description">
      Chronological index of 50 national and international conferences, keynotes, and study days delivered across Europe, North America, Africa, and Algeria.
    </p>
  </div>

  <!-- Search Filter -->
  <div class="filter-bar academic-card">
    <div class="search-box">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="confSearch" placeholder="Search by paper title, host university, country, or year..." />
    </div>
    <div class="conf-count" id="countDisplay">
      Total: <strong>{conferences.length}</strong> presentations
    </div>
  </div>

  <!-- Conferences List -->
  <div class="conferences-timeline" id="confTimeline">
    {conferences.map((conf) => (
      <article class="academic-card conf-card" data-text={conf.title.toLowerCase()}>
        <div class="conf-header">
          <span class="badge badge-gold">{conf.year}</span>
          <span class="conf-index">#{conf.id}</span>
        </div>
        <p class="conf-body-text">{conf.title}</p>
      </article>
    ))}
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('confSearch') as HTMLInputElement;
  const cards = document.querySelectorAll('.conf-card');
  const countDisplay = document.getElementById('countDisplay');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let visible = 0;

      cards.forEach((card) => {
        const text = card.getAttribute('data-text') || '';
        if (text.includes(query)) {
          (card as HTMLElement).style.display = 'block';
          visible++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (countDisplay) {
        countDisplay.innerHTML = `Showing <strong>${visible}</strong> presentations`;
      }
    });
  }
</script>

<style>
  .filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    min-width: 280px;
    background: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.5rem 0.85rem;
    color: var(--color-text-muted);
  }

  .search-box input {
    border: none;
    background: transparent;
    outline: none;
    font-size: 0.95rem;
    width: 100%;
    color: var(--color-text);
  }

  .conf-count {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .conferences-timeline {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .conf-card {
    border-left: 4px solid var(--color-accent);
  }

  .conf-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .conf-index {
    font-size: 0.8rem;
    font-weight: 700;
    color: #94a3b8;
  }

  .conf-body-text {
    font-size: 1rem;
    line-height: 1.65;
    color: #1e293b;
  }
</style>
