---
import Layout from '../layouts/Layout.astro';
import publications from '../data/publications.json';
---

<Layout title="Publications & Research" description="Complete peer-reviewed bibliography of Prof. Dr. Tahar Abbou including journal articles, book chapters, and books.">
  <div class="page-header">
    <span class="page-tag">Research Output</span>
    <h1 class="page-title">Publications & Books</h1>
    <p class="page-description">
      Complete peer-reviewed bibliography spanning African civilization, West African empires, trans-Saharan manuscript traditions, and colonial economic history.
    </p>
  </div>

  <!-- Search & Filter Controls -->
  <div class="filter-bar academic-card">
    <div class="search-box">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="pubSearch" placeholder="Search by title, keyword, journal, or topic..." />
    </div>
    <div class="pub-count" id="countDisplay">
      Showing <strong>{publications.length}</strong> publications
    </div>
  </div>

  <!-- Publications Chronological List -->
  <div class="publications-feed" id="pubFeed">
    {publications.map((pub) => (
      <article class="academic-card pub-card-item" data-text={pub.raw.toLowerCase()}>
        <div class="pub-item-header">
          <span class="badge badge-gold">Item #{pub.id}</span>
        </div>
        
        <p class="pub-text">{pub.raw}</p>

        {pub.url && (
          <div class="pub-actions">
            <a href={pub.url} target="_blank" rel="noopener noreferrer" class="btn btn-outline pub-source-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              View Publication / DOI / ASJP ↗
            </a>
          </div>
        )}
      </article>
    ))}
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('pubSearch') as HTMLInputElement;
  const cards = document.querySelectorAll('.pub-card-item');
  const countDisplay = document.getElementById('countDisplay');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let visible = 0;

      cards.forEach((card) => {
        const text = card.getAttribute('data-text') || '';
        if (text.includes(query)) {
          (card as HTMLElement).style.display = 'block';
          visible++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (countDisplay) {
        countDisplay.innerHTML = `Showing <strong>${visible}</strong> publications`;
      }
    });
  }
</script>

<style>
  .filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    min-width: 280px;
    background: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.5rem 0.85rem;
    color: var(--color-text-muted);
  }

  .search-box input {
    border: none;
    background: transparent;
    outline: none;
    font-size: 0.95rem;
    width: 100%;
    color: var(--color-text);
  }

  .pub-count {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .publications-feed {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pub-card-item {
    border-left: 4px solid var(--color-primary);
  }

  .pub-item-header {
    margin-bottom: 0.5rem;
  }

  .pub-text {
    font-size: 1.025rem;
    line-height: 1.7;
    color: #1e293b;
    margin-bottom: 1rem;
  }

  .pub-actions {
    display: flex;
    gap: 0.75rem;
  }

  .pub-source-btn {
    padding: 0.45rem 0.9rem;
    font-size: 0.825rem;
  }
</style>
