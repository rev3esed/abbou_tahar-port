---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const pubEntries = await getCollection('publications');
const publications = pubEntries
  .map(p => {
    const rawText = p.body?.trim() || p.data.title;
    const isArabic = /[\u0600-\u06FF]/.test(rawText);
    return {
      id: p.data.id || 0,
      title: p.data.title,
      year: p.data.year,
      url: p.data.url,
      raw: rawText,
      isArabic,
    };
  })
  .sort((a, b) => (b.year - a.year) || (b.id - a.id));

// Pre-calculate era counts
const countRecent = publications.filter(p => p.year >= 2020).length;
const countMid = publications.filter(p => p.year >= 2015 && p.year <= 2019).length;
const countEarly = publications.filter(p => p.year < 2015).length;
const countWithLink = publications.filter(p => !!p.url).length;
---

<Layout title="Publications & Peer-Reviewed Research" description="Complete peer-reviewed bibliography of Prof. Dr. Tahar Abbou including journal articles, book chapters, and research papers.">
  <div class="page-header">
    <span class="page-tag">Scholarship & Research</span>
    <h1 class="page-title">Publications & Academic Papers</h1>
    <p class="page-description">
      Chronological bibliography of peer-reviewed articles, scholarly monographs, and book chapters spanning African civilization, West African empires, trans-Saharan manuscript traditions, and colonial economic history.
    </p>
  </div>

  <!-- Filter & Search Command Center -->
  <div class="filter-wrapper">
    <div class="filter-controls-card academic-card">
      <!-- Search Row -->
      <div class="search-row">
        <div class="search-input-box">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="text" 
            id="pubSearch" 
            placeholder="Search by title, keyword, journal, co-author, or year..." 
            autocomplete="off"
          />
          <button type="button" id="clearSearch" class="clear-search-btn" title="Clear search" aria-label="Clear search">×</button>
        </div>

        <div class="filter-stats">
          <span class="stat-badge" id="statsDisplay">
            Showing <strong id="visibleCount">{publications.length}</strong> of {publications.length} publications
          </span>
        </div>
      </div>

      <!-- Quick Filter Pills -->
      <div class="filter-pills-row">
        <span class="filter-pills-label">Filter Era:</span>
        <div class="pills-group" id="filterPills">
          <button type="button" class="pill active" data-filter="all">All ({publications.length})</button>
          <button type="button" class="pill" data-filter="2020s">2020 – 2024 ({countRecent})</button>
          <button type="button" class="pill" data-filter="2015s">2015 – 2019 ({countMid})</button>
          <button type="button" class="pill" data-filter="2010s">2010 – 2014 ({countEarly})</button>
          <button type="button" class="pill" data-filter="linked">With Online Link / ASJP ({countWithLink})</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Publications Feed -->
  <div class="publications-feed" id="pubFeed">
    {publications.map((pub) => (
      <article 
        class="academic-card pub-card" 
        data-year={pub.year}
        data-has-link={pub.url ? "true" : "false"}
        data-search={pub.raw.toLowerCase()}
      >
        <div class="pub-card-top">
          <div class="pub-badges">
            <span class="badge badge-year">{pub.year}</span>
            {pub.isArabic && <span class="badge badge-arabic">Arabic / عربي</span>}
            {pub.url && <span class="badge badge-asjp">Peer-Reviewed / Indexed</span>}
          </div>
        </div>
        
        <div class={`pub-content ${pub.isArabic ? 'arabic-text' : ''}`}>
          <p class="pub-citation">{pub.raw}</p>
        </div>

        <div class="pub-actions-row">
          {pub.url && (
            <a 
              href={pub.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-outline btn-source"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              View Publication / ASJP Portal ↗
            </a>
          )}
          
          <button 
            type="button" 
            class="btn btn-ghost copy-citation-btn" 
            data-citation={pub.raw}
            title="Copy full citation"
          >
            <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="btn-text">Copy Citation</span>
          </button>
        </div>
      </article>
    ))}
  </div>

  <!-- Empty Search Results State -->
  <div class="empty-state" id="emptyState" style="display: none;">
    <div class="empty-icon">🔍</div>
    <h3>No matching publications found</h3>
    <p>Try searching for a different keyword, author, year, or clear your current filters.</p>
    <button type="button" class="btn btn-primary" id="resetFiltersBtn">Reset All Filters</button>
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('pubSearch') as HTMLInputElement;
  const clearBtn = document.getElementById('clearSearch') as HTMLButtonElement;
  const filterPills = document.querySelectorAll('#filterPills .pill');
  const cards = document.querySelectorAll('.pub-card');
  const visibleCountEl = document.getElementById('visibleCount');
  const emptyState = document.getElementById('emptyState');
  const resetBtn = document.getElementById('resetFiltersBtn');

  let activeFilter = 'all';
  let searchQuery = '';

  function applyFilters() {
    let count = 0;

    cards.forEach((card) => {
      const year = parseInt(card.getAttribute('data-year') || '0', 10);
      const hasLink = card.getAttribute('data-has-link') === 'true';
      const searchText = card.getAttribute('data-search') || '';

      // Check Pill Filter
      let matchesPill = true;
      if (activeFilter === '2020s') {
        matchesPill = year >= 2020;
      } else if (activeFilter === '2015s') {
        matchesPill = year >= 2015 && year <= 2019;
      } else if (activeFilter === '2010s') {
        matchesPill = year < 2015;
      } else if (activeFilter === 'linked') {
        matchesPill = hasLink;
      }

      // Check Search Query
      const matchesSearch = !searchQuery || searchText.includes(searchQuery);

      if (matchesPill && matchesSearch) {
        (card as HTMLElement).style.display = 'block';
        count++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (visibleCountEl) {
      visibleCountEl.textContent = count.toString();
    }

    if (emptyState) {
      emptyState.style.display = count === 0 ? 'block' : 'none';
    }

    if (clearBtn) {
      clearBtn.style.display = searchQuery ? 'block' : 'none';
    }
  }

  // Search Input Event
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      applyFilters();
    });
  }

  // Clear Search Button
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchQuery = '';
        applyFilters();
        searchInput.focus();
      }
    });
  }

  // Filter Pills Click Events
  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      filterPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeFilter = pill.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });

  // Reset Filters Button in Empty State
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      activeFilter = 'all';
      filterPills.forEach(p => {
        if (p.getAttribute('data-filter') === 'all') {
          p.classList.add('active');
        } else {
          p.classList.remove('active');
        }
      });
      applyFilters();
    });
  }

  // Copy Citation Button Functionality
  const copyBtns = document.querySelectorAll('.copy-citation-btn');
  copyBtns.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const citation = btn.getAttribute('data-citation') || '';
      const textSpan = btn.querySelector('.btn-text');
      try {
        await navigator.clipboard.writeText(citation);
        if (textSpan) textSpan.textContent = '✓ Copied!';
        btn.classList.add('copied');
        setTimeout(() => {
          if (textSpan) textSpan.textContent = 'Copy Citation';
          btn.classList.remove('copied');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });
  });
</script>

<style>
  .filter-wrapper {
    margin-bottom: 2.25rem;
  }

  .filter-controls-card {
    padding: 1.5rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  }

  .search-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .search-input-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    min-width: 300px;
    background: #f8fafc;
    border: 1.5px solid var(--color-border);
    border-radius: 8px;
    padding: 0.65rem 1rem;
    transition: all 0.2s ease;
    position: relative;
  }

  .search-input-box:focus-within {
    border-color: var(--color-primary);
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(10, 25, 47, 0.08);
  }

  .search-icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .search-input-box input {
    border: none;
    background: transparent;
    outline: none;
    font-size: 0.95rem;
    width: 100%;
    color: var(--color-text);
    font-family: inherit;
  }

  .clear-search-btn {
    border: none;
    background: #e2e8f0;
    color: #475569;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 14px;
    display: none;
    line-height: 1;
    font-weight: bold;
    padding: 0;
    transition: all 0.15s ease;
  }

  .clear-search-btn:hover {
    background: #cbd5e1;
    color: #0f172a;
  }

  .filter-stats {
    flex-shrink: 0;
  }

  .stat-badge {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    background: #f1f5f9;
    padding: 0.45rem 0.85rem;
    border-radius: 6px;
    border: 1px solid #e2e8f0;
  }

  .stat-badge strong {
    color: var(--color-primary);
  }

  .filter-pills-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 1rem;
    border-top: 1px solid #f1f5f9;
  }

  .filter-pills-label {
    font-size: 0.825rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #94a3b8;
  }

  .pills-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pill {
    background: #f8fafc;
    border: 1px solid var(--color-border);
    color: #475569;
    padding: 0.4rem 0.9rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pill:hover {
    background: #f1f5f9;
    color: var(--color-primary);
    border-color: #cbd5e1;
  }

  .pill.active {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
    box-shadow: 0 2px 6px rgba(10, 25, 47, 0.18);
  }

  /* Publications Feed & Cards */
  .publications-feed {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .pub-card {
    border-left: 4.5px solid var(--color-primary);
    padding: 1.75rem 2rem;
    position: relative;
    transition: all 0.25s ease;
  }

  .pub-card:hover {
    border-left-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 4px 10px -4px rgba(15, 23, 42, 0.04);
  }

  .pub-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .pub-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .badge-year {
    background: var(--color-primary);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.825rem;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
  }

  .badge-asjp {
    background: #f0fdf4;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .badge-arabic {
    background: #fffbeb;
    color: #92400e;
    border: 1px solid #fde68a;
  }

  .pub-content {
    margin-bottom: 1.25rem;
  }

  .pub-citation {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #0f172a;
    font-weight: 450;
  }

  .arabic-text {
    direction: rtl;
    text-align: right;
    font-family: 'Amiri', 'Traditional Arabic', serif, var(--font-sans);
    font-size: 1.15rem;
  }

  .pub-actions-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    padding-top: 1rem;
    border-top: 1px solid #f1f5f9;
  }

  .btn-source {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    border-color: #cbd5e1;
    color: var(--color-primary);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-source:hover {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
  }

  .btn-ghost {
    background: transparent;
    border: 1px solid #e2e8f0;
    color: #64748b;
    padding: 0.5rem 0.9rem;
    font-size: 0.825rem;
    border-radius: 8px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .btn-ghost:hover {
    background: #f8fafc;
    color: #0f172a;
    border-color: #cbd5e1;
  }

  .btn-ghost.copied {
    background: #f0fdf4;
    color: #166534;
    border-color: #bbf7d0;
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: #ffffff;
    border: 1px dashed var(--color-border);
    border-radius: 12px;
    margin-top: 2rem;
  }

  .empty-icon {
    font-size: 2.75rem;
    margin-bottom: 1rem;
  }

  .empty-state h3 {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .empty-state p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    max-width: 450px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 640px) {
    .pub-card {
      padding: 1.25rem;
    }

    .pub-citation {
      font-size: 0.975rem;
    }

    .search-input-box {
      min-width: 100%;
    }
  }
</style>
