---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="The requested page could not be found on the official academic website of Prof. Dr. Tahar Abbou.">
  <section class="not-found-card academic-card">
    <span class="badge badge-gold">404 • Not Found</span>
    <h1 class="not-found-title">Page Not Found</h1>
    <p class="not-found-desc">
      The page or resource you requested may have been moved or renamed. Use the links below to explore Prof. Dr. Tahar Abbou's academic portfolio.
    </p>
    <div class="not-found-actions">
      <a href="/" class="btn btn-primary">Return to Homepage</a>
      <a href="/publications" class="btn btn-outline">Publications</a>
      <a href="/conferences" class="btn btn-outline">Conferences</a>
      <a href="/teaching" class="btn btn-outline">Teaching & Courses</a>
    </div>
  </section>
</Layout>

<style>
  .not-found-card {
    max-width: 680px;
    margin: 3rem auto;
    text-align: center;
    padding: 3rem 2rem;
    border-top: 4px solid var(--color-accent);
  }

  .not-found-title {
    font-size: 2.25rem;
    margin: 1rem 0 0.75rem;
  }

  .not-found-desc {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
