---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { lang: 'ar' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
const activities = await getCollection('activities');

const pageTitles = {
  ar: "الأنشطة العلمية والمهام الأكاديمية",
  en: "Scientific Activities & Affiliations",
  fr: "Activités Scientifiques & Responsabilités",
};
---

<Layout title={pageTitles[lang as 'ar' | 'en' | 'fr']} lang={lang as 'ar' | 'en' | 'fr'}>
  <div class="page-header">
    <h1 class="page-title">{pageTitles[lang as 'ar' | 'en' | 'fr']}</h1>
    <p class="page-sub">
      {lang === 'ar' && "العضوية في المخابر والجمعيات الدولية، تأطير الأطروحات والمذكرات، وإدارة المراكز العلمية."}
      {lang === 'en' && "Research laboratory affiliations, international associations, thesis supervision, and leadership."}
      {lang === 'fr' && "Laboratoires de recherche, associations savantes, encadrement de thèses et responsabilités."}
    </p>
  </div>

  <div class="activities-grid">
    {activities.map((act) => (
      <div class="card activity-card">
        <span class="badge badge-primary">{act.data.period}</span>
        <h3 class="act-title">{act.data.title}</h3>
        <p class="act-inst">🏛️ {act.data.institution}</p>
        <p class="act-role">👤 {act.data.role}</p>
        <div class="act-body">{act.body}</div>
      </div>
    ))}
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 1rem;
  }
  .page-title {
    font-size: 1.85rem;
    color: var(--color-primary);
  }
  .page-sub {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }
  .act-title {
    font-size: 1.25rem;
    margin: 0.5rem 0 0.25rem;
    color: var(--color-primary);
  }
  .act-inst {
    font-weight: 600;
    color: #334155;
    margin-bottom: 0.2rem;
  }
  .act-role {
    font-size: 0.9rem;
    color: var(--color-secondary);
    margin-bottom: 0.75rem;
  }
  .act-body {
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.6;
  }
</style>
