---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { lang: 'ar' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
const allConfs = await getCollection('conferences');
const sortedConfs = allConfs.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const pageTitles = {
  ar: "المؤتمرات والملتقيات الوطنية والدولية",
  en: "National & International Conferences",
  fr: "Colloques & Conférences Scientifiques",
};

const roleMap = {
  presenter: { ar: "مداخلة علمية", en: "Presenter", fr: "Intervenant" },
  keynote: { ar: "محاضرة افتتاحية رئيسية", en: "Keynote Speaker", fr: "Conférencier principal" },
  committee: { ar: "عضو اللجنة العلمية", en: "Scientific Committee", fr: "Comité scientifique" },
  chair: { ar: "رئيس جلسة", en: "Session Chair", fr: "Président de séance" },
};
---

<Layout title={pageTitles[lang as 'ar' | 'en' | 'fr']} lang={lang as 'ar' | 'en' | 'fr'}>
  <div class="page-header">
    <h1 class="page-title">{pageTitles[lang as 'ar' | 'en' | 'fr']}</h1>
    <p class="page-sub">
      {lang === 'ar' && "المشاركات في الندوات والملتقيات العلمية محلياً ودولياً، وأوراق العمل المقدمة."}
      {lang === 'en' && "Keynotes, presented papers, and scientific committee roles in academic forums."}
      {lang === 'fr' && "Communications présentées, conférences plénières et comités scientifiques."}
    </p>
  </div>

  <div class="conf-timeline">
    {sortedConfs.map((conf) => {
      const roleText = (roleMap[conf.data.role] as any)?.[lang] || conf.data.role;
      return (
        <article class="card conf-card">
          <div class="conf-top">
            <span class={`badge ${conf.data.scope === 'international' ? 'badge-primary' : 'badge-gold'}`}>
              {conf.data.scope === 'international' ? (lang === 'ar' ? 'مؤتمر دولي' : 'International') : (lang === 'ar' ? 'ملتقى وطني' : 'National')}
            </span>
            <span class="conf-date">{String(conf.data.date)}</span>
          </div>

          <h3 class="conf-paper">{conf.data.title}</h3>
          <p class="conf-name"><strong>{conf.data.conference_name}</strong></p>
          <p class="conf-meta">
            📍 {conf.data.location} | 🎖️ {roleText}
          </p>

          {conf.body && (
            <p class="conf-abstract">{conf.body}</p>
          )}

          {conf.data.file && (
            <div class="conf-actions">
              <a href={conf.data.file} class="btn btn-outline" target="_blank" download>
                📄 {lang === 'ar' ? 'تحميل البرنامج / الشهادة' : 'Download Program / Certificate'}
              </a>
            </div>
          )}
        </article>
      );
    })}
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 1rem;
  }
  .page-title {
    font-size: 1.85rem;
    color: var(--color-primary);
  }
  .page-sub {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }
  .conf-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .conf-date {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .conf-paper {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: 0.35rem;
  }
  .conf-name {
    color: #334155;
    margin-bottom: 0.35rem;
  }
  .conf-meta {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }
  .conf-abstract {
    background: #f8fafc;
    padding: 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    color: #475569;
  }
  .conf-actions {
    margin-top: 0.5rem;
  }
</style>
