---
import Layout from '../../layouts/Layout.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { lang: 'ar' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
const allPubs = await getCollection('publications');

// Sort by year descending
const sortedPubs = allPubs.sort((a, b) => b.data.year - a.data.year);

const titles = {
  ar: "قائمة المنشورات والأبحاث العلمية",
  en: "Academic Publications & Books",
  fr: "Publications Scientifiques & Ouvrages",
};
---

<Layout title={titles[lang as 'ar' | 'en' | 'fr']} lang={lang as 'ar' | 'en' | 'fr'}>
  <div class="page-header">
    <h1 class="page-title">{titles[lang as 'ar' | 'en' | 'fr']}</h1>
    <p class="page-sub">
      {lang === 'ar' && "مجموعة الأبحاث المحكمة، المقالات في المجلات المصنفة، والكتب وفصول الكتب الجماعية."}
      {lang === 'en' && "Peer-reviewed journal articles, book chapters, authored books, and proceedings."}
      {lang === 'fr' && "Articles de revues à comité de lecture, chapitres d'ouvrages collectifs et livres."}
    </p>
  </div>

  <div class="pub-list">
    {sortedPubs.map((pub) => (
      <PublicationCard
        title={pub.data.title}
        authors={pub.data.authors}
        journal={pub.data.journal}
        year={pub.data.year}
        type={pub.data.type}
        volumePages={pub.data.volume_pages}
        doiUrl={pub.data.doi_url}
        pdfFile={pub.data.pdf_file}
        abstract={pub.body}
        lang={lang as 'ar' | 'en' | 'fr'}
      />
    ))}
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 1rem;
  }
  .page-title {
    font-size: 1.85rem;
    color: var(--color-primary);
  }
  .page-sub {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }
</style>
