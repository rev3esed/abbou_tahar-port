---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { lang: 'ar' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
const links = await getCollection('links');

const pageTitles = {
  ar: "روابط ومصادر مفيدة",
  en: "Useful Links & Portals",
  fr: "Liens Utiles & Ressources",
};
---

<Layout title={pageTitles[lang as 'ar' | 'en' | 'fr']} lang={lang as 'ar' | 'en' | 'fr'}>
  <div class="page-header">
    <h1 class="page-title">{pageTitles[lang as 'ar' | 'en' | 'fr']}</h1>
    <p class="page-sub">
      {lang === 'ar' && "بوابات جامعية، منصات المجلات العلمية، مراكز أبحاث المخطوطات، وروابط أكاديمية موثوقة."}
      {lang === 'en' && "Academic repositories, journal portals, manuscript databases, and research links."}
      {lang === 'fr' && "Portails universitaires, plateformes de revues scientifiques et banques de manuscrits."}
    </p>
  </div>

  <div class="links-grid">
    {links.map((link) => (
      <a href={link.data.url} target="_blank" rel="noopener noreferrer" class="card link-card">
        <span class="badge badge-primary">{link.data.category}</span>
        <h3 class="link-title">{link.data.title} ↗</h3>
        {link.data.description && <p class="link-desc">{link.data.description}</p>}
        <span class="link-url">{link.data.url}</span>
      </a>
    ))}
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 1rem;
  }
  .page-title {
    font-size: 1.85rem;
    color: var(--color-primary);
  }
  .page-sub {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }
  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .link-card {
    transition: transform 0.2s, box-shadow 0.2s;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .link-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(0,0,0,0.08);
  }
  .link-title {
    font-size: 1.15rem;
    color: var(--color-primary);
    margin: 0.5rem 0 0.35rem;
  }
  .link-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }
  .link-url {
    font-size: 0.75rem;
    color: var(--color-secondary);
    word-break: break-all;
  }
</style>
