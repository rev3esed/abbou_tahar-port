---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "Home", href: "/" },
  { label: "Publications", href: "/publications" },
  { label: "Conferences", href: "/conferences" },
  { label: "Teaching", href: "/teaching" },
  { label: "Activities", href: "/activities" },
  { label: "Gallery", href: "/gallery" },
  { label: "Awards", href: "/awards" },
  { label: "Links", href: "/links" },
];
---

<header class="site-header" id="siteHeader">
  <div class="container header-container">
    <a href="/" class="brand">
      <div class="brand-monogram">TA</div>
      <div class="brand-info">
        <span class="brand-name">Prof. Dr. Tahar Abbou</span>
        <span class="brand-title">University of Adrar, Algeria</span>
      </div>
    </a>

    <!-- Mobile Menu Toggle Button -->
    <button 
      class="mobile-toggle" 
      aria-label="Toggle navigation menu" 
      aria-expanded="false" 
      aria-controls="navMenu"
      id="menuToggle"
      type="button"
    >
      <span class="icon-menu" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </span>
      <span class="icon-close" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </span>
    </button>

    <!-- Navigation Menu & Actions -->
    <nav class="nav-menu" id="navMenu">
      <ul class="nav-list">
        {navItems.map((item) => {
          const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
          return (
            <li>
              <a href={item.href} class={`nav-link ${isActive ? 'active' : ''}`}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      <div class="header-actions">
        <a href="/uploads/cv-tahar-abbou.pdf" class="btn btn-outline cv-btn" target="_blank" download>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Curriculum Vitae (PDF)
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (function() {
    function setupNav() {
      var toggle = document.getElementById('menuToggle');
      var menu = document.getElementById('navMenu');
      if (!toggle || !menu) return;

      if (toggle.getAttribute('data-bound') === 'true') return;
      toggle.setAttribute('data-bound', 'true');

      function toggleOpen(force) {
        var isCurrentlyOpen = menu.classList.contains('is-open');
        var shouldOpen = typeof force === 'boolean' ? force : !isCurrentlyOpen;
        if (shouldOpen) {
          menu.classList.add('is-open');
          toggle.classList.add('is-active');
          toggle.setAttribute('aria-expanded', 'true');
        } else {
          menu.classList.remove('is-open');
          toggle.classList.remove('is-active');
          toggle.setAttribute('aria-expanded', 'false');
        }
      }

      toggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        toggleOpen();
      });

      // Close menu when clicking any nav link
      var links = menu.querySelectorAll('a');
      for (var i = 0; i < links.length; i++) {
        links[i].addEventListener('click', function() {
          toggleOpen(false);
        });
      }

      // Close when clicking outside header/menu
      document.addEventListener('click', function(e) {
        if (menu.classList.contains('is-open')) {
          var target = e.target;
          if (!menu.contains(target) && !toggle.contains(target)) {
            toggleOpen(false);
          }
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && menu.classList.contains('is-open')) {
          toggleOpen(false);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupNav);
    } else {
      setupNav();
    }
    document.addEventListener('astro:page-load', setupNav);
  })();
</script>

<style>
  .site-header {
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    position: relative;
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    min-width: 0;
  }

  .brand-monogram {
    width: 40px;
    height: 40px;
    background: var(--color-primary);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: -0.05em;
    font-family: var(--font-serif);
    border: 1px solid rgba(194, 155, 56, 0.3);
    flex-shrink: 0;
  }

  .brand-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand-title {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Desktop Nav */
  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-list {
    display: flex;
    list-style: none;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--color-primary);
    background: #f1f5f9;
  }

  .nav-link.active {
    color: var(--color-primary);
    background: #e2e8f0;
  }

  .cv-btn {
    padding: 0.5rem 1rem;
    font-size: 0.825rem;
    font-weight: 600;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
  }

  /* Mobile Toggle Button */
  .mobile-toggle {
    display: none;
    background: #ffffff;
    border: 1.5px solid var(--color-border);
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 8px;
    cursor: pointer;
    color: var(--color-primary);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s ease;
    position: relative;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-toggle:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
  }

  .mobile-toggle .icon-close {
    display: none;
  }

  .mobile-toggle .icon-menu {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* When open: switch icon */
  .mobile-toggle.is-active,
  .mobile-toggle[aria-expanded="true"] {
    background: #f1f5f9;
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .mobile-toggle.is-active .icon-menu,
  .mobile-toggle[aria-expanded="true"] .icon-menu {
    display: none !important;
  }

  .mobile-toggle.is-active .icon-close,
  .mobile-toggle[aria-expanded="true"] .icon-close {
    display: flex !important;
    align-items: center;
    justify-content: center;
  }

  /* Mobile & Tablet Responsive Layout */
  @media (max-width: 1040px) {
    .mobile-toggle {
      display: inline-flex !important;
    }

    .nav-menu {
      display: none !important;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      width: 100%;
      background: #ffffff !important;
      border-bottom: 2px solid var(--color-border);
      flex-direction: column;
      padding: 1.25rem 1.5rem 1.75rem;
      gap: 1.25rem;
      box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.15), 0 8px 10px -6px rgba(15, 23, 42, 0.1);
      z-index: 9999;
      max-height: calc(100vh - 72px);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .nav-menu.is-open {
      display: flex !important;
      animation: mobileMenuSlideDown 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .nav-list {
      flex-direction: column;
      width: 100%;
      gap: 0.35rem;
      align-items: stretch;
    }

    .nav-link {
      display: block;
      width: 100%;
      padding: 0.75rem 1rem;
      font-size: 1rem;
      border-radius: 8px;
    }

    .nav-link.active {
      background: #f1f5f9;
      color: var(--color-primary);
      border-left: 3px solid var(--color-accent);
    }

    .header-actions {
      width: 100%;
      padding-top: 0.5rem;
      border-top: 1px solid #f1f5f9;
    }

    .cv-btn {
      width: 100%;
      justify-content: center;
      padding: 0.75rem;
      font-size: 0.95rem;
      background: #f8fafc;
      border-color: #cbd5e1;
    }
  }

  @keyframes mobileMenuSlideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 480px) {
    .brand-monogram {
      width: 36px;
      height: 36px;
      font-size: 0.85rem;
    }

    .brand-name {
      font-size: 1.025rem;
    }

    .brand-title {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 360px) {
    .brand-title {
      display: none;
    }
  }
</style>
