---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "Home", href: "/" },
  { label: "Publications", href: "/publications" },
  { label: "Conferences", href: "/conferences" },
  { label: "Teaching", href: "/teaching" },
  { label: "Activities", href: "/activities" },
  { label: "Gallery", href: "/gallery" },
  { label: "Awards", href: "/awards" },
  { label: "Links", href: "/links" },
];
---

<header class="site-header" id="siteHeader">
  <div class="container header-container">
    <a href="/" class="brand">
      <div class="brand-monogram">TA</div>
      <div class="brand-info">
        <span class="brand-name">Prof. Dr. Tahar Abbou</span>
        <span class="brand-title">University of Adrar, Algeria</span>
      </div>
    </a>

    <!-- Mobile Menu Toggle Button (Accessible & High Touch Target) -->
    <button 
      class="mobile-toggle" 
      aria-label="Toggle navigation menu" 
      aria-expanded="false" 
      aria-controls="navMenu"
      id="menuToggle"
      type="button"
    >
      <!-- Hamburger Icon (Shown when closed) -->
      <svg class="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <!-- Close 'X' Icon (Shown when open) -->
      <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Navigation Menu & Actions -->
    <nav class="nav-menu" id="navMenu">
      <ul class="nav-list">
        {navItems.map((item) => {
          const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
          return (
            <li>
              <a href={item.href} class={`nav-link ${isActive ? 'active' : ''}`}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      <div class="header-actions">
        <a href="/uploads/cv-tahar-abbou.pdf" class="btn btn-outline cv-btn" target="_blank" download>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Curriculum Vitae (PDF)
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  function initMobileNav() {
    const toggle = document.getElementById('menuToggle');
    const menu = document.getElementById('navMenu');
    if (!toggle || !menu) return;

    function setMenuState(open: boolean) {
      if (open) {
        menu.classList.add('is-open');
        toggle.classList.add('is-active');
        toggle.setAttribute('aria-expanded', 'true');
        document.body.classList.add('mobile-nav-locked');
      } else {
        menu.classList.remove('is-open');
        toggle.classList.remove('is-active');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('mobile-nav-locked');
      }
    }

    // Click toggle button
    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isCurrentlyOpen = menu.classList.contains('is-open');
      setMenuState(!isCurrentlyOpen);
    });

    // Close when clicking any nav link
    const navLinks = menu.querySelectorAll('a');
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        setMenuState(false);
      });
    });

    // Close when clicking anywhere outside header
    document.addEventListener('click', (e) => {
      if (menu.classList.contains('is-open')) {
        const target = e.target as HTMLElement;
        if (!menu.contains(target) && !toggle.contains(target)) {
          setMenuState(false);
        }
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) {
        setMenuState(false);
      }
    });

    // Close automatically if viewport resized to desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth > 1040 && menu.classList.contains('is-open')) {
        setMenuState(false);
      }
    });
  }

  // Run on initial load and view transitions
  initMobileNav();
  document.addEventListener('astro:page-load', initMobileNav);
</script>

<style>
  .site-header {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    position: relative;
  }

  /* Brand Styling */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    min-width: 0; /* Allow text flex shrink on small phones */
  }

  .brand-monogram {
    width: 40px;
    height: 40px;
    background: var(--color-primary);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: -0.05em;
    font-family: var(--font-serif);
    border: 1px solid rgba(194, 155, 56, 0.3);
    flex-shrink: 0;
  }

  .brand-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand-title {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Desktop Nav */
  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-list {
    display: flex;
    list-style: none;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--color-primary);
    background: #f1f5f9;
  }

  .nav-link.active {
    color: var(--color-primary);
    background: #e2e8f0;
  }

  .cv-btn {
    padding: 0.5rem 1rem;
    font-size: 0.825rem;
    font-weight: 600;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
  }

  /* Mobile Toggle Button */
  .mobile-toggle {
    display: none;
    background: transparent;
    border: 1.5px solid var(--color-border);
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 8px;
    cursor: pointer;
    color: var(--color-primary);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s ease;
    position: relative;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-toggle:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
  }

  .mobile-toggle:active {
    background: #e2e8f0;
  }

  .mobile-toggle .icon-close {
    display: none;
  }

  .mobile-toggle .icon-menu {
    display: block;
  }

  .mobile-toggle.is-active {
    background: #f1f5f9;
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .mobile-toggle.is-active .icon-menu {
    display: none;
  }

  .mobile-toggle.is-active .icon-close {
    display: block;
  }

  /* Responsive Rules for Mobile & Tablet */
  @media (max-width: 1040px) {
    .mobile-toggle {
      display: inline-flex;
    }

    .nav-menu {
      display: none;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      width: 100%;
      background: #ffffff;
      border-bottom: 2px solid var(--color-border);
      flex-direction: column;
      padding: 1.25rem 1.5rem 1.75rem;
      gap: 1.25rem;
      box-shadow: 0 16px 32px -4px rgba(15, 23, 42, 0.12), 0 6px 12px -2px rgba(15, 23, 42, 0.05);
      z-index: 1001;
      max-height: calc(100vh - 72px);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .nav-menu.is-open {
      display: flex;
      animation: mobileMenuSlideDown 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .nav-list {
      flex-direction: column;
      width: 100%;
      gap: 0.35rem;
      align-items: stretch;
    }

    .nav-link {
      display: block;
      width: 100%;
      padding: 0.75rem 1rem;
      font-size: 1rem;
      border-radius: 8px;
    }

    .nav-link.active {
      background: #f1f5f9;
      color: var(--color-primary);
      border-left: 3px solid var(--color-accent);
    }

    .header-actions {
      width: 100%;
      padding-top: 0.5rem;
      border-top: 1px solid #f1f5f9;
    }

    .cv-btn {
      width: 100%;
      justify-content: center;
      padding: 0.75rem;
      font-size: 0.95rem;
      background: #f8fafc;
      border-color: #cbd5e1;
    }
  }

  @keyframes mobileMenuSlideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 480px) {
    .brand-monogram {
      width: 36px;
      height: 36px;
      font-size: 0.85rem;
    }

    .brand-name {
      font-size: 1.025rem;
    }

    .brand-title {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 360px) {
    .brand-title {
      display: none; /* Avoid overflowing tiny 320px screens */
    }
  }
</style>
