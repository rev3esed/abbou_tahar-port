---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "Home", href: "/" },
  { label: "Publications", href: "/publications" },
  { label: "Conferences", href: "/conferences" },
  { label: "Teaching", href: "/teaching" },
  { label: "Activities", href: "/activities" },
  { label: "Gallery", href: "/gallery" },
  { label: "Awards", href: "/awards" },
  { label: "Links", href: "/links" },
];
---

<header class="site-header">
  <div class="container header-container">
    <a href="/" class="brand">
      <div class="brand-monogram">TA</div>
      <div class="brand-info">
        <span class="brand-name">Prof. Dr. Tahar Abbou</span>
        <span class="brand-title">University of Adrar, Algeria</span>
      </div>
    </a>

    <!-- Mobile Menu Toggle Button -->
    <button class="mobile-toggle" aria-label="Toggle navigation menu" id="menuToggle">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <nav class="nav-menu" id="navMenu">
      <ul class="nav-list">
        {navItems.map((item) => {
          const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
          return (
            <li>
              <a href={item.href} class={`nav-link ${isActive ? 'active' : ''}`}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      <div class="header-actions">
        <a href="/uploads/cv-tahar-abbou.pdf" class="btn btn-outline cv-btn" target="_blank" download>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          CV (PDF)
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menuToggle');
  const menu = document.getElementById('navMenu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('is-open');
    });
  }
</script>

<style>
  .site-header {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
  }

  .brand-monogram {
    width: 38px;
    height: 38px;
    background: var(--color-primary);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: -0.05em;
    font-family: var(--font-serif);
    border: 1px solid rgba(194, 155, 56, 0.3);
  }

  .brand-info {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.2;
  }

  .brand-title {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-list {
    display: flex;
    list-style: none;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-primary);
    background: #f1f5f9;
  }

  .nav-link.active {
    color: var(--color-primary);
    background: #e2e8f0;
  }

  .cv-btn {
    padding: 0.45rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 6px;
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: 1px solid var(--color-border);
    padding: 0.4rem;
    border-radius: 6px;
    cursor: pointer;
    color: var(--color-primary);
  }

  @media (max-width: 1040px) {
    .mobile-toggle {
      display: block;
    }

    .nav-menu {
      display: none;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      background: #ffffff;
      border-bottom: 1px solid var(--color-border);
      flex-direction: column;
      padding: 1.5rem;
      gap: 1.25rem;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
    }

    .nav-menu.is-open {
      display: flex;
    }

    .nav-list {
      flex-direction: column;
      width: 100%;
      gap: 0.5rem;
    }

    .nav-link {
      display: block;
      width: 100%;
      padding: 0.6rem 1rem;
    }

    .header-actions {
      width: 100%;
    }

    .cv-btn {
      width: 100%;
    }
  }
</style>
